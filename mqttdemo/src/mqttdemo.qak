 //----------------------------------------------------------
 //ATTORI CHE USANO MQTT con mqttBroker
 //----------------------------------------------------------

  
/*  
 * -----------------------------------------
 Sperimentazione di requst / reply NOV 2024
 * -----------------------------------------
 */

//WARNING: MQTT richiede che ogni client connesso a un broker 
//abbia un Client ID univoco: il nome engager esiste già in basicrobot
//TODO: proibire l'uso di alcuni nomi nell'editore del linguaggio
QActor engagermock context ctxmmqtt{
	State s0 initial{
		delay 2000 //Give time to connect to the mqtt broker
		subscribe "answ_engage_engagermock"
		delay 1000
		println("$name | STARTS emitting request engage ") color green
		//CASO DI basicrobot
		[#  val REQmsg = MsgUtil.buildRequest("engagermock", "engage","engage($MyName,200)","basicrobot")
			publish(REQmsg.toString(),"robotevents")
			//Non riceve su answ_engage_engagermock se non fa subscribe "answ_engage_engagermock"
		#]		  
		//CASO di basicrobotmock
//		[# 	val REQmsg = MsgUtil.buildRequest("engagermock", "engage","engage($MyName,200)","basicrobotmock")
//			publish(REQmsg.toString(),"applsevents")	//		 
//		#]		  
	}
	Transition t0
		whenReply engagedone -> endengagermock
		
    State endengagermock{
    	printCurrentMessage color green
    	println("$name | BYE") color green
    }
}

